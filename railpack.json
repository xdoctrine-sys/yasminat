{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": ["bun install --no-save"]
    },
    "build": {
      "commands": ["bun run build"]
    }
  },
  "deploy": {
    "startCommand": "bash /app/entrypoint.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}
